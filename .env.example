# Kopiraj u .env.local. Ista imena idu i na Vercel.
# Javni sajt čita Sanity. Ako ID nije unet, čita public/site-content.json.

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Token ostaje samo na serveru. Ne stavljaj NEXT_PUBLIC_ ispred njega.
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=
