# Nokti & Trepavice — kopirajte u .env.example → .env
# Lokalni `npm run dev` ne objavljuje u Git. Objava radi na Vercelu.

# Link „autor“ u podnožju
VITE_PORTFOLIO_URL=https://www.example.dev/

# Forma za termin (Formspree). Bez ovoga sajt koristi ugrađeni demo endpoint.
VITE_FORMSPREE_ENDPOINT=https://formspree.io/enter

# --- Admin PIN (SHA-256 hex, 64 znaka) ---
# npm run pin-hash -- VAS-PIN
# Isti hash na Vercel Production. Lokalni fallback PIN je `freedom` dok hash nije postavljen.
VITE_ADMIN_PIN_HASH=
ADMIN_PIN_HASH=

# Samo lokalno, nikad na Vercel (PIN uđe u bundle):
# VITE_ADMIN_PIN=

# --- Objava u Git (samo Vercel server, nikad VITE_) ---
# Vercel često pregazi ime GITHUB_TOKEN. Koristite CMS_GITHUB_TOKEN.
# Fine-grained PAT: Contents Read and write, samo repo ovog sajta.
CMS_GITHUB_TOKEN=
GITHUB_REPO = nalog/nokti-trepavice
GITHUB_BRANCH = master

# --- Sanity (prazno dok projekat ne postoji) ---
# Javni sajt i dalje čita public/site-content.json dok ID nije unet.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=

# Isti javni ključevi, imena koja Next ubacuje u pregledač (VITE_ i dalje radi lokalno).
NEXT_PUBLIC_PORTFOLIO_URL=https://www.example.dev/
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/enter
NEXT_PUBLIC_ADMIN_PIN_HASH=
